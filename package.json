{
  "name": "zernio-gateway",
  "private": true,
  "version": "0.1.0",
  "description": "Zeptly Social \u2014 Zernio-backed provider gateway implementing Gateway Contract v1",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @zeptly-gateway/api dev",
    "dev:worker": "pnpm --filter @zeptly-gateway/worker dev",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "build:api": "pnpm --filter @zeptly-gateway/api build",
    "build:worker": "pnpm --filter @zeptly-gateway/worker build",
    "start:api": "node apps/api/dist/main.js",
    "start:worker": "node apps/worker/dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "drizzle-kit generate --config packages/database/drizzle.config.ts",
    "db:migrate": "tsx packages/database/src/migrate.ts",
    "db:check": "drizzle-kit check --config packages/database/drizzle.config.ts",
    "db:seed": "tsx packages/database/src/seed.ts",
    "openapi:generate": "tsx apps/api/src/scripts/generate-openapi.ts",
    "openapi:check": "tsx apps/api/src/scripts/generate-openapi.ts --check",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm openapi:check && pnpm zs1:check",
    "zs": "tsx scripts/zs.ts",
    "zs1:vectors": "tsx scripts/zs1-vectors.ts",
    "zs1:check": "tsx scripts/zs1-vectors.ts --check",
    "migrate:prod": "node apps/api/dist/migrate.js",
    "db:drift": "drizzle-kit generate --config packages/database/drizzle.config.ts --name drift_check && git diff --exit-code -- migrations && test -z \"$(git status --porcelain -- migrations)\"",
    "dev:mock-zernio": "tsx packages/test-utils/src/mock-zernio-server.ts",
    "test:live": "ZERNIO_LIVE_TESTS=true vitest run --project live"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "globals": "^16.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  }
}
