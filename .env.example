# Zernio Gateway — environment contract. Copy to .env for local development.
# NEVER commit real values. In Railway set these as service variables.

NODE_ENV=development

# PostgreSQL (docker compose up -d provides this locally)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zeptly_social

# Shared service credential for Zeptly → Zernio Gateway request signing (>= 32 chars).
# Generate: openssl rand -base64 48
ZEPTLY_SERVICE_SECRET=
# Optional: previous secret accepted during rotation.
ZEPTLY_SERVICE_SECRET_PREVIOUS=

# Zernio (server-side only). Create an API key in the Zernio dashboard.
ZERNIO_API_KEY=
# Secret of the Zernio webhook endpoint that points at <PUBLIC_BASE_URL>/v1/webhooks/zernio (min 16 chars).
ZERNIO_WEBHOOK_SECRET=
ZERNIO_API_BASE_URL=https://zernio.com/api
# Zernio profile name = prefix + opaque per-workspace tenant ref (never the Zeptly workspace id).
ZERNIO_PROFILE_PREFIX=zs-

# Public https origin of the API (Zernio redirects end users back here after OAuth).
PUBLIC_BASE_URL=http://localhost:8080
# Comma-separated Zeptly origins allowed as provisioning returnUrl.
ALLOWED_RETURN_URL_ORIGINS=http://localhost:3000

API_PORT=8080
LOG_LEVEL=info

WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=2000

# Opt-in live Zernio test suite (never runs in normal CI).
ZERNIO_LIVE_TESTS=false
